-function RootComponent() { const { queryClient } = Route.useRouteContext(); const router = useRouter(); useEffect(() => { const { data } = supabase.auth.onAuthStateChange((event) => { if (!["SIGNED_IN", "SIGNED_OUT", "USER_UPDATED"].includes(event)) return; router.invalidate(); if (event !== "SIGNED_OUT") queryClient.invalidateQueries(); }); return () => data.subscription.unsubscribe(); }, [queryClient, router]); return <QueryClientProvider client={queryClient}><Outlet /><Toaster position="top-right" richColors /></QueryClientProvider>; }

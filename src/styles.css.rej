+/* ===========================================================
+   GOOGLE FONTS IMPORT (loaded in __root.tsx head)
+   =========================================================== */
+
+/* ===========================================================
+   BRAND MARK & IDENTITY
+   =========================================================== */
+.brand-mark {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.6rem;
+  color: var(--foreground);
+  font: 700 1.25rem var(--font-display);
+  text-decoration: none;
+  letter-spacing: -0.02em;
+}
+.brand-mark .brand-icon {
+  display: grid;
+  place-items: center;
+  width: 2rem;
+  height: 2rem;
+  background: var(--im-red);
+  border-radius: 0.4rem;
+  color: white;
+  font-size: 1.1rem;
+  font-weight: 900;
+  flex-shrink: 0;
+}
+.brand-mark .brand-text { color: var(--im-red-dark); }
+.eyebrow {
+  color: var(--im-red);
+  font-size: 0.7rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.12em;
+}
+
+/* ===========================================================
+   AUTH PAGES
+   =========================================================== */
+.auth-shell {
+  min-height: 100vh;
+  display: grid;
+  grid-template-columns: minmax(20rem, 48%) 1fr;
+  background: var(--background);
+}
+.auth-intro {
+  position: relative;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  min-height: 100vh;
+  padding: 3rem clamp(2.5rem, 6vw, 5rem);
+  background: var(--im-red-dark);
+}
+.auth-intro::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(135deg, #7f1d1d 0%, #c62828 50%, #991b1b 100%);
+  z-index: 0;
+}
+.auth-intro-grid {
+  position: absolute;
+  inset: 0;
+  background-image:
+    linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
+  background-size: 32px 32px;
+  z-index: 1;
+}
+.auth-intro::after {
+  content: "";
+  position: absolute;
+  right: -8rem;
+  bottom: -8rem;
+  width: 28rem;
+  height: 28rem;
+  border: 1px solid rgba(255,255,255,0.12);
+  border-radius: 50%;
+  box-shadow:
+    0 0 0 4rem rgba(255,255,255,0.04),
+    0 0 0 8rem rgba(255,255,255,0.025);
+  z-index: 1;
+}
+.auth-copy {
+  position: relative;
+  z-index: 2;
+  max-width: 34rem;
+  margin-block: auto;
+}
+.auth-copy .eyebrow { color: rgba(255,255,255,0.7); }
+.auth-copy h1 {
+  margin-top: 0.8rem;
+  font: 700 clamp(2.8rem, 4.5vw, 4.2rem) / 1.0 var(--font-display);
+  color: #ffffff;
+  letter-spacing: -0.03em;
+}
+.auth-copy h1 span { color: #fca5a5; }
+.auth-copy > p:not(.eyebrow) {
+  max-width: 30rem;
+  margin-top: 1.4rem;
+  color: rgba(255,255,255,0.72);
+  font-size: 1rem;
+  line-height: 1.7;
+}
+.auth-copy ul {
+  display: grid;
+  gap: 0.75rem;
+  margin: 2rem 0 0;
+  padding: 0;
+  list-style: none;
+}
+.auth-copy li {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  color: rgba(255,255,255,0.88);
+  font-size: 0.9rem;
+  font-weight: 500;
+}
+.auth-copy li .li-icon {
+  display: grid;
+  place-items: center;
+  width: 1.6rem;
+  height: 1.6rem;
+  background: rgba(255,255,255,0.15);
+  border-radius: 50%;
+  flex-shrink: 0;
+  font-size: 0.75rem;
+}
+.auth-quote {
+  position: relative;
+  z-index: 2;
+  color: rgba(255,255,255,0.5);
+  font: italic 0.85rem var(--font-display);
+}
+
+.auth-form-side {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 2rem;
+  background: var(--card);
+}
+.auth-form-wrap { width: min(100%, 26rem); }
 .mobile-brand { display: none; }
-.auth-form-wrap h2 { margin-top: .65rem; font: 600 2.25rem/1.1 var(--font-display); }
-.form-lead { margin-top: .8rem; color: var(--muted-foreground); line-height: 1.6; font-size: .9rem; }
-.google-button { width: 100%; height: 3rem; margin-top: 1.75rem; }
-.google-g { font-weight: 700; color: oklch(.55 .2 35); }
-.form-divider { display: flex; align-items: center; gap: 1rem; margin: 1.4rem 0; color: var(--muted-foreground); font-size: .72rem; }
-.form-divider::before,.form-divider::after { content: ""; height: 1px; flex: 1; background: var(--border); }
-.auth-form,.field { display: grid; gap: .7rem; }
-.auth-form { gap: 1.1rem; }.field-label-row { display:flex; justify-content:space-between; align-items:center; }.text-button,.auth-switch button { border:0; padding:0; background:none; color:var(--primary); font:600 .78rem var(--font-sans); }.password-wrap { position:relative; }.password-wrap input { padding-right:3rem; height:2.8rem; }.password-wrap button { position:absolute; right:.25rem; top:.25rem; }.auth-form input { height:2.8rem; }.submit-button { width:100%; height:3rem; margin-top:.2rem; }.auth-switch { margin-top:1.5rem; text-align:center; color:var(--muted-foreground); font-size:.82rem; }
-.app-layout { min-height:100vh; }.sidebar { position:fixed; inset:0 auto 0 0; z-index:40; display:flex; width:16.5rem; flex-direction:column; padding:1.7rem 1rem 1.2rem; border-right:1px solid var(--border); background:var(--card); }.sidebar-top { display:flex; align-items:center; justify-content:space-between; padding:0 .65rem; }.mobile-close { display:none; }.capture-button { width:100%; margin-top:1.8rem; justify-content:flex-start; }.main-nav { display:grid; gap:.3rem; margin-top:1.5rem; }.main-nav a { display:flex; align-items:center; gap:.8rem; min-height:2.6rem; padding:.6rem .75rem; border-radius:var(--radius); color:var(--muted-foreground); text-decoration:none; font-size:.86rem; font-weight:500; transition:.18s ease; }.main-nav a svg { width:1.12rem; }.main-nav a:hover,.main-nav .nav-active { color:var(--foreground); background:var(--secondary); }.main-nav .nav-active { box-shadow:inset 3px 0 var(--primary); }.sidebar-profile { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:.7rem; margin-top:auto; padding-top:1rem; border-top:1px solid var(--border); }.avatar { display:grid; width:2.25rem; aspect-ratio:1; place-items:center; border-radius:50%; background:var(--soft-blue); color:var(--accent-foreground); font-weight:700; }.sidebar-profile div:nth-child(2) { min-width:0; display:grid; }.sidebar-profile strong { overflow:hidden; text-overflow:ellipsis; font-size:.78rem; white-space:nowrap; }.sidebar-profile span { color:var(--muted-foreground); font-size:.7rem; }.app-main { min-height:100vh; margin-left:16.5rem; }.mobile-header,.mobile-capture { display:none; }
-.page-wrap { width:min(100% - 3rem, 72rem); margin:0 auto; padding:3.2rem 0 5rem; }.narrow-page { max-width:46rem; }.page-heading,.today-header { display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; margin-bottom:2.2rem; }.page-heading h1,.today-header h1 { margin-top:.45rem; font:600 clamp(2.2rem,4vw,3.4rem)/1 var(--font-display); }.page-heading p:not(.eyebrow),.today-header p:not(.eyebrow) { margin-top:.65rem; color:var(--muted-foreground); }.focus-band { display:grid; grid-template-columns:1fr minmax(14rem,22rem); align-items:center; gap:2rem; padding:1.5rem 1.7rem; border:1px solid var(--border); border-radius:var(--radius-xl); background:var(--card); box-shadow:0 10px 30px color-mix(in oklch,var(--foreground) 5%,transparent); }.focus-copy { display:flex; align-items:center; gap:1rem; }.focus-copy>div:last-child { display:grid; gap:.25rem; }.focus-copy span,.progress-label span { color:var(--muted-foreground); font-size:.74rem; }.focus-copy strong { font:600 1.15rem var(--font-display); }.focus-icon,.callout-icon,.empty-icon,.collection-icon,.capture-icon,.setting-icon { display:grid; place-items:center; flex:0 0 auto; color:var(--primary); background:var(--soft-green); border-radius:50%; }.focus-icon { width:2.75rem; aspect-ratio:1; }.progress-label { display:flex; justify-content:space-between; margin-bottom:.5rem; }.progress-label strong { font-size:.78rem; }.progress-track { height:.4rem; overflow:hidden; border-radius:1rem; background:var(--muted); }.progress-track div { height:100%; background:var(--primary); transition:width .3s ease; }.today-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.3rem; margin-top:1.3rem; }.content-section { min-height:15rem; padding:1.35rem; border:1px solid var(--border); border-radius:var(--radius-xl); background:var(--card); }.section-title,.section-title>div { display:flex; align-items:center; justify-content:space-between; gap:.6rem; }.section-title svg { width:1.1rem; color:var(--primary); }.section-title h2 { font:600 1.12rem var(--font-display); }.section-title a { display:flex; align-items:center; gap:.3rem; color:var(--primary); text-decoration:none; font-size:.72rem; font-weight:700; }.section-title a svg { width:.8rem; }.compact-list { display:grid; gap:.65rem; margin-top:1.3rem; }.task-row,.appointment-row { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:.75rem; min-height:2.7rem; padding:.55rem .65rem; border-bottom:1px solid var(--border); font-size:.84rem; }.task-row button { display:grid; place-items:center; width:1.35rem; aspect-ratio:1; border:1px solid var(--input); border-radius:50%; background:transparent; color:transparent; }.task-row button:hover { color:var(--primary); }.task-row small { padding:.2rem .4rem; border-radius:.3rem; font-weight:600; }.priority-high { color:var(--destructive); background:color-mix(in oklch,var(--destructive) 10%,transparent); }.priority-medium { color:var(--accent-foreground); background:var(--soft-blue); }.priority-low { color:var(--secondary-foreground); background:var(--soft-green); }.appointment-row time { color:var(--primary); font-weight:700; }.mini-empty { display:grid; min-height:10rem; place-items:center; color:var(--muted-foreground); font-size:.84rem; }.inbox-callout { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:1rem; margin-top:1.3rem; padding:1.4rem 1.5rem; border:1px solid var(--border); border-radius:var(--radius-xl); background:var(--soft-blue); }.callout-icon { width:2.6rem; aspect-ratio:1; background:var(--card); }.inbox-callout span { color:var(--accent-foreground); font-size:.7rem; font-weight:700; text-transform:uppercase; }.inbox-callout h2 { margin-top:.18rem; font:600 1.1rem var(--font-display); }.inbox-callout p { margin-top:.25rem; color:var(--muted-foreground); font-size:.78rem; }.calm-note { display:flex; justify-content:center; align-items:center; gap:.4rem; margin-top:2rem; color:var(--muted-foreground); font:italic .82rem var(--font-display); }.calm-note svg { width:.9rem; }
-.capture-dialog { max-width:38rem; border-radius:var(--radius-xl); }.capture-icon { width:2.5rem; aspect-ratio:1; margin-bottom:.5rem; }.capture-textarea { min-height:10rem; resize:none; padding:1rem; font-size:1rem; line-height:1.6; }.capture-hint { display:flex; align-items:center; gap:.4rem; color:var(--muted-foreground); font-size:.74rem; }.capture-hint svg { width:.9rem; }.capture-actions { display:flex; justify-content:flex-end; gap:.5rem; }.inbox-list,.collection-list { display:grid; gap:.75rem; }.inbox-item { display:grid; grid-template-columns:auto 1fr; gap:1rem; padding:1.15rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--card); }.inbox-content>p { line-height:1.55; }.item-meta { display:flex; align-items:center; gap:1rem; margin-top:.65rem; color:var(--muted-foreground); font-size:.7rem; }.item-meta span { display:flex; align-items:center; gap:.3rem; }.item-meta svg { width:.8rem; }.status-dot::before { content:""; width:.4rem; aspect-ratio:1; border-radius:50%; background:var(--soft-yellow); box-shadow:inset 0 0 0 1px var(--border); }.suggestion { display:flex; align-items:center; gap:.45rem; margin-top:.85rem; padding:.55rem .7rem; border-radius:var(--radius); background:var(--surface); font-size:.76rem; }.suggestion span { margin-right:auto; color:var(--secondary-foreground); font-weight:600; }.item-actions { grid-column:2; display:flex; flex-wrap:wrap; gap:.15rem; padding-top:.75rem; border-top:1px solid var(--border); }.item-actions button { color:var(--muted-foreground); }.item-actions button:hover { color:var(--foreground); }.item-actions .destructive-action:hover { color:var(--destructive); }.bulk-bar { display:flex; align-items:center; justify-content:space-between; margin-bottom:.8rem; padding:.55rem .8rem; border-radius:var(--radius); background:var(--secondary); font-size:.8rem; }.empty-state { display:grid; min-height:22rem; place-items:center; align-content:center; gap:.8rem; padding:2rem; border:1px dashed var(--border); border-radius:var(--radius-xl); text-align:center; }.empty-state h2 { font:600 1.35rem var(--font-display); }.empty-state p { color:var(--muted-foreground); font-size:.86rem; }.empty-icon,.collection-icon,.setting-icon { width:3rem; aspect-ratio:1; }.collection-row { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:1rem; min-height:5rem; padding:1rem 1.1rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--card); }.collection-icon { width:2.5rem; }.collection-row h2,.sticky-card h2 { font-size:.92rem; font-weight:600; }.collection-row p,.sticky-card p { margin-top:.3rem; color:var(--muted-foreground); font-size:.78rem; }.row-state { width:1rem; color:var(--muted-foreground); }.sticky-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; }.sticky-card { min-height:10rem; padding:1.2rem; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--soft-yellow); }.settings-section { display:grid; gap:1.2rem; margin-bottom:1rem; padding:1.5rem; border:1px solid var(--border); border-radius:var(--radius-xl); background:var(--card); }.settings-section h2 { font:600 1.2rem var(--font-display); }.setting-row,.setting-copy { display:flex; align-items:center; justify-content:space-between; gap:1rem; }.setting-copy { justify-content:flex-start; }.setting-copy strong { font-size:.9rem; }.setting-copy p { margin-top:.2rem; color:var(--muted-foreground); font-size:.76rem; }.setting-icon { width:2.5rem; }.reset-page,.error-page { min-height:100vh; display:grid; place-items:center; padding:1.5rem; }.reset-card,.error-page>div { display:grid; width:min(100%,28rem); gap:1.2rem; padding:2rem; border:1px solid var(--border); border-radius:var(--radius-xl); background:var(--card); box-shadow:0 16px 50px color-mix(in oklch,var(--foreground) 7%,transparent); }.reset-card h1,.error-page h1 { font:600 2rem var(--font-display); }.reset-card>p,.error-page p { color:var(--muted-foreground); line-height:1.6; }
-.sidebar-backdrop { display:none; }
+.auth-form-wrap h2 {
+  margin-top: 0.65rem;
+  font: 700 2rem / 1.1 var(--font-display);
+  letter-spacing: -0.02em;
+  color: var(--im-red-dark);
+}
+.form-lead {
+  margin-top: 0.8rem;
+  color: var(--muted-foreground);
+  line-height: 1.6;
+  font-size: 0.88rem;
+}
+.form-divider {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  margin: 1.4rem 0;
+  color: var(--muted-foreground);
+  font-size: 0.72rem;
+}
+.form-divider::before, .form-divider::after {
+  content: "";
+  height: 1px;
+  flex: 1;
+  background: var(--border);
+}
+.auth-form, .field { display: grid; gap: 0.7rem; }
+.auth-form { gap: 1.1rem; }
+.field-label-row { display: flex; justify-content: space-between; align-items: center; }
+.text-button, .auth-switch button {
+  border: 0; padding: 0; background: none;
+  color: var(--im-red); font: 600 0.78rem var(--font-sans);
+}
+.text-button:hover { color: var(--im-red-dark); }
+.password-wrap { position: relative; }
+.password-wrap input { padding-right: 3rem; height: 2.85rem; }
+.password-wrap button { position: absolute; right: 0.25rem; top: 0.25rem; }
+.auth-form input { height: 2.85rem; }
+.submit-button { width: 100%; height: 3rem; margin-top: 0.2rem; background: var(--im-red) !important; }
+.submit-button:hover { background: var(--im-red-dark) !important; }
+.auth-switch {
+  margin-top: 1.5rem;
+  text-align: center;
+  color: var(--muted-foreground);
+  font-size: 0.82rem;
+}
+
+/* Profile picker (demo mode) */
+.profile-picker {
+  display: grid;
+  gap: 0.65rem;
+  margin: 1.2rem 0;
+}
+.profile-card {
+  display: flex;
+  align-items: center;
+  gap: 0.85rem;
+  padding: 0.85rem 1rem;
+  border: 1.5px solid var(--border);
+  border-radius: var(--radius-lg);
+  cursor: pointer;
+  transition: all 0.15s ease;
+  background: var(--card);
+}
+.profile-card:hover { border-color: var(--im-red); background: var(--im-red-light); }
+.profile-card.selected { border-color: var(--im-red); background: var(--im-red-light); box-shadow: 0 0 0 3px rgba(198,40,40,0.12); }
+.profile-card .profile-avatar {
+  display: grid;
+  place-items: center;
+  width: 2.4rem;
+  height: 2.4rem;
+  border-radius: 50%;
+  background: var(--im-red);
+  color: white;
+  font: 700 0.9rem var(--font-sans);
+  flex-shrink: 0;
+}
+.profile-card .profile-info strong { display: block; font-size: 0.88rem; }
+.profile-card .profile-info span { color: var(--muted-foreground); font-size: 0.75rem; }
+.profile-badge {
+  margin-left: auto;
+  padding: 0.2rem 0.55rem;
+  border-radius: 2rem;
+  font-size: 0.65rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+}
+.badge-admin { background: #fef3c7; color: #92400e; }
+.badge-manager { background: #dbeafe; color: #1e40af; }
+.badge-seller { background: var(--im-red-light); color: var(--im-red); }
+
+/* ===========================================================
+   APP SHELL & SIDEBAR
+   =========================================================== */
+.app-layout { min-height: 100vh; display: flex; background: var(--background); }
+
+.sidebar {
+  position: fixed;
+  inset: 0 auto 0 0;
+  z-index: 40;
+  display: flex;
+  width: 17rem;
+  flex-direction: column;
+  padding: 0 0 1rem;
+  background: var(--im-red-dark);
+  border-right: none;
+  box-shadow: 4px 0 20px rgba(0,0,0,0.15);
+}
+.sidebar-logo {
+  display: flex;
+  align-items: center;
+  gap: 0.65rem;
+  padding: 1.4rem 1.2rem 1.2rem;
+  border-bottom: 1px solid rgba(255,255,255,0.1);
+}
+.sidebar-logo .logo-icon {
+  display: grid;
+  place-items: center;
+  width: 2.2rem;
+  height: 2.2rem;
+  background: white;
+  border-radius: 0.4rem;
+  color: var(--im-red);
+  font-size: 1rem;
+  font-weight: 900;
+  flex-shrink: 0;
+}
+.sidebar-logo .logo-text { line-height: 1.2; }
+.sidebar-logo .logo-text strong {
+  display: block;
+  font: 700 0.88rem var(--font-sans);
+  color: white;
+  letter-spacing: -0.01em;
+}
+.sidebar-logo .logo-text span { color: rgba(255,255,255,0.55); font-size: 0.7rem; }
+
+.sidebar-section-label {
+  padding: 1.1rem 1.1rem 0.4rem;
+  font-size: 0.63rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.1em;
+  color: rgba(255,255,255,0.38);
+}
+
+.main-nav {
+  display: grid;
+  gap: 0.15rem;
+  padding: 0 0.6rem;
+}
+.main-nav a {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  min-height: 2.6rem;
+  padding: 0.6rem 0.75rem;
+  border-radius: var(--radius-md);
+  color: rgba(255,255,255,0.65);
+  text-decoration: none;
+  font-size: 0.85rem;
+  font-weight: 500;
+  transition: all 0.15s ease;
+}
+.main-nav a svg { width: 1.05rem; height: 1.05rem; flex-shrink: 0; }
+.main-nav a:hover { color: white; background: rgba(255,255,255,0.1); }
+.main-nav .nav-active {
+  color: white;
+  background: rgba(255,255,255,0.16);
+  font-weight: 600;
+}
+.main-nav .nav-active svg { color: #fca5a5; }
+
+.sidebar-profile {
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: center;
+  gap: 0.7rem;
+  margin-top: auto;
+  padding: 0.85rem 1rem;
+  border-top: 1px solid rgba(255,255,255,0.1);
+}
+.sidebar-profile .avatar {
+  display: grid;
+  width: 2.2rem;
+  height: 2.2rem;
+  place-items: center;
+  border-radius: 50%;
+  background: rgba(255,255,255,0.18);
+  color: white;
+  font: 700 0.8rem var(--font-sans);
+  flex-shrink: 0;
+}
+.sidebar-profile strong {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  font-size: 0.78rem;
+  font-weight: 600;
+  white-space: nowrap;
+  color: white;
+  display: block;
+}
+.sidebar-profile span {
+  color: rgba(255,255,255,0.5);
+  font-size: 0.68rem;
+  display: block;
+}
+
+.app-main { min-height: 100vh; margin-left: 17rem; display: flex; flex-direction: column; }
+.mobile-header, .mobile-capture { display: none; }
+.mobile-close { display: none; }
+.sidebar-backdrop { display: none; }
+
+/* ===========================================================
+   PAGE LAYOUTS
+   =========================================================== */
+.page-wrap {
+  width: min(100% - 3rem, 84rem);
+  margin: 0 auto;
+  padding: 2.5rem 0 5rem;
+}
+.narrow-page { max-width: 52rem; }
+
+.page-heading {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 2rem;
+  margin-bottom: 2rem;
+}
+.page-heading h1 {
+  font: 700 2rem / 1.15 var(--font-display);
+  letter-spacing: -0.025em;
+  color: var(--im-red-dark);
+}
+.page-heading p:not(.eyebrow) {
+  margin-top: 0.4rem;
+  color: var(--muted-foreground);
+  font-size: 0.88rem;
+}
+.page-heading-actions { display: flex; gap: 0.6rem; align-items: center; flex-shrink: 0; }
+
+/* ===========================================================
+   IM BUTTON VARIANTS
+   =========================================================== */
+.btn-im-primary {
+  background: var(--im-red) !important;
+  color: white !important;
+  border-color: var(--im-red) !important;
+}
+.btn-im-primary:hover { background: var(--im-red-dark) !important; }
+
+.btn-im-outline {
+  background: transparent !important;
+  color: var(--im-red) !important;
+  border-color: var(--im-red) !important;
+}
+.btn-im-outline:hover { background: var(--im-red-light) !important; }
+
+/* ===========================================================
+   STATS & KPI CARDS
+   =========================================================== */
+.stats-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
+  gap: 1rem;
+  margin-bottom: 1.8rem;
+}
+.stat-card {
+  padding: 1.25rem 1.4rem;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-xl);
+  background: var(--card);
+  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
+  transition: box-shadow 0.15s ease;
+  cursor: default;
+}
+.stat-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
+.stat-card .stat-icon {
+  display: grid;
+  place-items: center;
+  width: 2.4rem;
+  height: 2.4rem;
+  border-radius: 0.5rem;
+  margin-bottom: 0.9rem;
+}
+.stat-card .stat-value {
+  font: 700 2rem / 1 var(--font-display);
+  letter-spacing: -0.03em;
+}
+.stat-card .stat-label {
+  margin-top: 0.25rem;
+  font-size: 0.78rem;
+  color: var(--muted-foreground);
+  font-weight: 500;
+}
+.stat-card .stat-trend {
+  display: flex;
+  align-items: center;
+  gap: 0.3rem;
+  margin-top: 0.6rem;
+  font-size: 0.72rem;
+  font-weight: 600;
+}
+.stat-red   .stat-icon { background: #fef2f2; color: var(--im-red); }
+.stat-amber .stat-icon { background: #fef3c7; color: #d97706; }
+.stat-green .stat-icon { background: #f0fdf4; color: #16a34a; }
+.stat-blue  .stat-icon { background: #eff6ff; color: #2563eb; }
+.stat-slate .stat-icon { background: #f8fafc; color: #64748b; }
+
+/* ===========================================================
+   COMMERCIAL OFFER ÔÇö TELA PRINCIPAL
+   =========================================================== */
+.offer-layout {
+  display: grid;
+  grid-template-columns: 1fr 380px;
+  gap: 1.5rem;
+  align-items: start;
+}
+.offer-form-panel {
+  display: grid;
+  gap: 1.25rem;
+}
+.offer-section {
+  padding: 1.5rem;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-xl);
+  background: var(--card);
+  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
+}
+.offer-section-title {
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+  margin-bottom: 1.1rem;
+  font: 600 1rem var(--font-display);
+  color: var(--im-red-dark);
+}
+.offer-section-title svg { color: var(--im-red); width: 1.05rem; }
+.offer-section-number {
+  display: grid;
+  place-items: center;
+  width: 1.5rem;
+  height: 1.5rem;
+  border-radius: 50%;
+  background: var(--im-red);
+  color: white;
+  font-size: 0.72rem;
+  font-weight: 700;
+  flex-shrink: 0;
+}
+
+/* Course cards */
+.course-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
+  gap: 0.75rem;
+}
+.course-card {
+  border: 2px solid var(--border);
+  border-radius: var(--radius-lg);
+  overflow: hidden;
+  cursor: pointer;
+  transition: all 0.15s ease;
+  background: var(--card);
+  position: relative;
+}
+.course-card:hover { border-color: var(--im-red); box-shadow: 0 4px 16px rgba(198,40,40,0.12); }
+.course-card.selected { border-color: var(--im-red); box-shadow: 0 0 0 3px rgba(198,40,40,0.15); }
+.course-card .course-img {
+  width: 100%;
+  height: 5.5rem;
+  object-fit: cover;
+  background: #f3f4f6;
+}
+.course-card .course-info { padding: 0.65rem 0.75rem; }
+.course-card .course-name { font-size: 0.78rem; font-weight: 600; line-height: 1.3; color: var(--im-red-dark); }
+.course-card .course-meta { margin-top: 0.3rem; font-size: 0.65rem; color: var(--muted-foreground); }
+.course-card .selected-check {
+  position: absolute;
+  top: 0.4rem;
+  right: 0.4rem;
+  width: 1.3rem;
+  height: 1.3rem;
+  background: var(--im-red);
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  color: white;
+  font-size: 0.7rem;
+}
+
+/* Area cards */
+.area-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
+  gap: 0.65rem;
+}
+.area-card {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.5rem;
+  padding: 0.9rem 0.5rem;
+  border: 2px solid var(--border);
+  border-radius: var(--radius-lg);
+  cursor: pointer;
+  transition: all 0.15s ease;
+  background: var(--card);
+  text-align: center;
+}
+.area-card:hover { border-color: var(--im-red); background: var(--im-red-light); }
+.area-card.selected { border-color: var(--im-red); background: var(--im-red-light); }
+.area-card .area-icon-wrap {
+  display: grid;
+  place-items: center;
+  width: 2.5rem;
+  height: 2.5rem;
+  border-radius: 50%;
+}
+.area-card span { font-size: 0.73rem; font-weight: 600; color: var(--im-red-dark); line-height: 1.3; }
+
+/* Payment selection */
+.payment-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 0.65rem;
+}
+.payment-option {
+  display: flex;
+  align-items: center;
+  gap: 0.65rem;
+  padding: 0.85rem 1rem;
+  border: 2px solid var(--border);
+  border-radius: var(--radius-lg);
+  cursor: pointer;
+  transition: all 0.15s ease;
+  background: var(--card);
+  font-size: 0.82rem;
+  font-weight: 500;
+}
+.payment-option:hover { border-color: var(--im-red); }
+.payment-option.selected { border-color: var(--im-red); background: var(--im-red-light); }
+.payment-option svg { color: var(--im-red); flex-shrink: 0; }
+
+.installments-select { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem; }
+.installment-chip {
+  padding: 0.3rem 0.75rem;
+  border: 1.5px solid var(--border);
+  border-radius: 2rem;
+  font-size: 0.75rem;
+  font-weight: 600;
+  cursor: pointer;
+  transition: all 0.12s ease;
+  background: var(--card);
+  color: var(--foreground);
+}
+.installment-chip:hover { border-color: var(--im-red); color: var(--im-red); }
+.installment-chip.selected { border-color: var(--im-red); background: var(--im-red); color: white; }
+
+/* ===========================================================
+   OFFER RESULT PANEL (direita)
+   =========================================================== */
+.offer-result-panel {
+  position: sticky;
+  top: 1.5rem;
+}
+.offer-result-card {
+  border: 2px solid var(--border);
+  border-radius: var(--radius-xl);
+  overflow: hidden;
+  background: var(--card);
+  box-shadow: 0 8px 32px rgba(0,0,0,0.08);
+}
+.offer-result-header {
+  background: linear-gradient(135deg, var(--im-red-dark), var(--im-red));
+  padding: 1.3rem 1.4rem 1rem;
+  color: white;
+}
+.offer-result-header .offer-course-name {
+  font: 700 1.05rem / 1.2 var(--font-display);
+  margin-top: 0.5rem;
+}
+.offer-result-header .offer-course-meta {
+  margin-top: 0.3rem;
+  font-size: 0.75rem;
+  opacity: 0.75;
+  display: flex;
+  gap: 0.75rem;
+}
+
+.offer-price-original {
+  padding: 0.9rem 1.4rem 0;
+  font-size: 0.82rem;
+  color: var(--muted-foreground);
+}
+.offer-price-original del { font-size: 1.05rem; color: var(--muted-foreground); }
+
+.offer-benefits-list {
+  padding: 0.75rem 1.4rem;
+  display: grid;
+  gap: 0.5rem;
+}
+.benefit-line {
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+  padding: 0.55rem 0.75rem;
+  background: #fef2f2;
+  border-radius: var(--radius-md);
+  border-left: 3px solid var(--im-red);
+}
+.benefit-line .benefit-icon {
+  font-size: 0.9rem;
+  flex-shrink: 0;
+}
+.benefit-line .benefit-name {
+  flex: 1;
+  font-size: 0.78rem;
+  font-weight: 600;
+  color: var(--im-red-dark);
+}
+.benefit-line .benefit-amount {
+  font-size: 0.82rem;
+  font-weight: 700;
+  color: var(--im-red);
+  flex-shrink: 0;
+}
+
+.offer-savings-badge {
+  margin: 0 1.4rem;
+  padding: 0.6rem 1rem;
+  background: linear-gradient(135deg, #d97706, #f59e0b);
+  border-radius: var(--radius-lg);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  color: white;
+}
+.offer-savings-badge .savings-label { font-size: 0.75rem; font-weight: 700; opacity: 0.9; }
+.offer-savings-badge .savings-amount { font: 700 1.1rem var(--font-display); }
+
+.offer-final-price {
+  padding: 1rem 1.4rem 0.25rem;
+  text-align: center;
+}
+.offer-final-price .final-label {
+  font-size: 0.72rem;
+  color: var(--muted-foreground);
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  font-weight: 600;
+}
+.offer-final-price .final-amount {
+  font: 700 2.4rem / 1 var(--font-display);
+  color: var(--im-red-dark);
+  letter-spacing: -0.03em;
+}
+.offer-final-price .final-installments {
+  margin-top: 0.3rem;
+  font-size: 0.9rem;
+  font-weight: 600;
+  color: var(--muted-foreground);
+}
+.offer-final-price .final-installments strong { color: var(--im-red); }
+
+.offer-timer {
+  margin: 0.75rem 1.4rem;
+  padding: 0.65rem 1rem;
+  background: var(--muted);
+  border-radius: var(--radius-lg);
+  display: flex;
+  align-items: center;
+  gap: 0.65rem;
+}
+.offer-timer .timer-label { font-size: 0.72rem; color: var(--muted-foreground); flex: 1; }
+.offer-timer .timer-value {
+  font: 700 1rem var(--font-display);
+  color: var(--im-red);
+  font-variant-numeric: tabular-nums;
+}
+.offer-timer.timer-expiring { background: #fef2f2; }
+.offer-timer.timer-expiring .timer-value { color: var(--im-red); }
+
+.offer-actions {
+  padding: 1rem 1.4rem 1.4rem;
+  display: grid;
+  gap: 0.5rem;
+}
+
+/* ===========================================================
+   STUDENT MODE (Modo Aluno ÔÇö Apresenta├º├úo Imersiva)
+   =========================================================== */
+.student-mode-overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 100;
+  background: linear-gradient(135deg, var(--im-red-dark) 0%, #9b1c1c 40%, var(--im-red) 100%);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: 2rem;
+  overflow-y: auto;
+}
+.student-mode-overlay .sm-grid {
+  position: absolute;
+  inset: 0;
+  background-image:
+    linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
+  background-size: 40px 40px;
+  pointer-events: none;
+}
+.student-mode-card {
+  position: relative;
+  width: min(100%, 680px);
+  background: white;
+  border-radius: 1.5rem;
+  overflow: hidden;
+  box-shadow: 0 32px 80px rgba(0,0,0,0.35);
+}
+.student-mode-course-img {
+  width: 100%;
+  height: 14rem;
+  object-fit: cover;
+}
+.student-mode-body { padding: 2rem; }
+.student-mode-eyebrow {
+  font-size: 0.7rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.12em;
+  color: var(--im-red);
+}
+.student-mode-course-title {
+  font: 700 2rem / 1.15 var(--font-display);
+  color: var(--im-red-dark);
+  letter-spacing: -0.02em;
+  margin: 0.4rem 0 0;
+}
+.student-mode-course-meta {
+  display: flex;
+  gap: 1rem;
+  margin-top: 0.6rem;
+  font-size: 0.8rem;
+  color: var(--muted-foreground);
+  font-weight: 500;
+}
+.student-mode-sep { height: 1px; background: var(--border); margin: 1.25rem 0; }
+.student-mode-from {
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+  margin-bottom: 0.75rem;
+  font-size: 0.82rem;
+  color: var(--muted-foreground);
+}
+.student-mode-from del { font-size: 1.1rem; }
+.student-mode-benefits {
+  display: grid;
+  gap: 0.5rem;
+  margin-bottom: 1rem;
+}
+.sm-benefit {
+  display: flex;
+  align-items: center;
+  gap: 0.65rem;
+  padding: 0.6rem 0.85rem;
+  background: #fef2f2;
+  border-left: 3px solid var(--im-red);
+  border-radius: 0.5rem;
+}
+.sm-benefit .sm-b-name { flex: 1; font-size: 0.82rem; font-weight: 600; color: var(--im-red-dark); }
+.sm-benefit .sm-b-value { font: 700 0.88rem var(--font-sans); color: var(--im-red); }
+
+.student-mode-savings {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0.75rem 1rem;
+  background: linear-gradient(135deg, #d97706, #f59e0b);
+  border-radius: 0.75rem;
+  color: white;
+  margin-bottom: 1.25rem;
+}
+.student-mode-savings .sm-s-label { font-size: 0.75rem; font-weight: 700; opacity: 0.9; }
+.student-mode-savings .sm-s-value { font: 700 1.2rem var(--font-display); }
+
+.student-mode-price-block { text-align: center; margin-bottom: 1.25rem; }
+.student-mode-price-label {
+  font-size: 0.7rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.1em;
+  color: var(--muted-foreground);
+}
+.student-mode-price {
+  font: 700 3.5rem / 1 var(--font-display);
+  color: var(--im-red-dark);
+  letter-spacing: -0.04em;
+}
+.student-mode-installments {
+  font-size: 1rem;
+  font-weight: 500;
+  color: var(--muted-foreground);
+}
+.student-mode-installments strong { color: var(--im-red); font-weight: 700; }
+
+.student-mode-timer {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.5rem;
+  margin-bottom: 1.25rem;
+  padding: 0.65rem;
+  background: #fef2f2;
+  border-radius: 0.5rem;
+  font-size: 0.82rem;
+  color: var(--im-red-dark);
+  font-weight: 600;
+}
+.student-mode-timer .sm-timer-count {
+  font: 700 1.1rem var(--font-display);
+  color: var(--im-red);
+  font-variant-numeric: tabular-nums;
+}
+
+.student-mode-cta {
+  width: 100%;
+  height: 3.5rem;
+  font-size: 1.1rem !important;
+  font-weight: 700 !important;
+  background: var(--im-red) !important;
+  color: white !important;
+  border-radius: 0.75rem !important;
+  letter-spacing: -0.01em;
+  box-shadow: 0 8px 24px rgba(198,40,40,0.35) !important;
+}
+.student-mode-cta:hover { background: var(--im-red-dark) !important; transform: translateY(-1px); }
+
+.student-mode-footer {
+  text-align: center;
+  margin-top: 1rem;
+  font-size: 0.72rem;
+  color: var(--muted-foreground);
+}
+.student-mode-exit {
+  position: fixed;
+  top: 1.25rem;
+  right: 1.25rem;
+  z-index: 101;
+  padding: 0.5rem 1rem;
+  background: rgba(255,255,255,0.15);
+  border: 1px solid rgba(255,255,255,0.3);
+  border-radius: 2rem;
+  color: white;
+  font-size: 0.78rem;
+  font-weight: 600;
+  cursor: pointer;
+  transition: all 0.15s ease;
+  backdrop-filter: blur(8px);
+}
+.student-mode-exit:hover { background: rgba(255,255,255,0.25); }
+
+/* ===========================================================
+   CRM KANBAN
+   =========================================================== */
+.kanban-board {
+  display: flex;
+  gap: 1rem;
+  overflow-x: auto;
+  padding-bottom: 1.5rem;
+  align-items: flex-start;
+  min-height: calc(100vh - 12rem);
+}
+.kanban-board::-webkit-scrollbar { height: 0.4rem; }
+.kanban-board::-webkit-scrollbar-track { background: transparent; }
+.kanban-board::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2rem; }
+
+.kanban-column {
+  flex-shrink: 0;
+  width: 16.5rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+}
+.kanban-column-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem;
+  padding: 0.6rem 0.75rem;
+  border-radius: var(--radius-lg);
+  background: var(--card);
+  border: 1px solid var(--border);
+  position: sticky;
+  top: 0;
+  z-index: 2;
+}
+.kanban-column-header .col-title {
+  font-size: 0.8rem;
+  font-weight: 700;
+  flex: 1;
+}
+.kanban-col-count {
+  display: grid;
+  place-items: center;
+  min-width: 1.4rem;
+  height: 1.4rem;
+  padding: 0 0.35rem;
+  border-radius: 2rem;
+  font-size: 0.68rem;
+  font-weight: 700;
+  background: var(--muted);
+  color: var(--muted-foreground);
+}
+.kanban-cards { display: grid; gap: 0.6rem; }
+.kanban-card {
+  padding: 1rem;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--card);
+  cursor: pointer;
+  transition: all 0.15s ease;
+  box-shadow: 0 1px 4px rgba(0,0,0,0.04);
+}
+.kanban-card:hover {
+  border-color: var(--im-red);
+  box-shadow: 0 4px 16px rgba(198,40,40,0.1);
+  transform: translateY(-1px);
+}
+.kanban-card .kc-name { font-size: 0.85rem; font-weight: 700; color: var(--foreground); }
+.kanban-card .kc-phone { font-size: 0.72rem; color: var(--muted-foreground); margin-top: 0.2rem; }
+.kanban-card .kc-course {
+  margin-top: 0.6rem;
+  padding: 0.3rem 0.5rem;
+  background: var(--im-red-light);
+  border-radius: var(--radius-sm);
+  font-size: 0.72rem;
+  color: var(--im-red-dark);
+  font-weight: 600;
+}
+.kanban-card .kc-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-top: 0.65rem;
+  padding-top: 0.65rem;
+  border-top: 1px solid var(--border);
+}
+.kanban-card .kc-value { font: 700 0.88rem var(--font-display); color: var(--im-red-dark); }
+.kanban-card .kc-badges { display: flex; gap: 0.3rem; }
+.kc-badge {
+  padding: 0.18rem 0.45rem;
+  border-radius: 2rem;
+  font-size: 0.62rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+.kc-badge-timer { background: #fef2f2; color: var(--im-red); }
+.kc-badge-overdue { background: #dc2626; color: white; }
+.kc-badge-followup { background: #eff6ff; color: #1e40af; }
+.kc-badge-won { background: #f0fdf4; color: #16a34a; }
+
+/* ===========================================================
+   STUDENT LIST & DETAIL
+   =========================================================== */
+.students-table-row {
+  display: grid;
+  grid-template-columns: 2.2rem 1fr 1fr auto auto;
+  align-items: center;
+  gap: 1rem;
+  padding: 0.9rem 1rem;
+  border-bottom: 1px solid var(--border);
+  transition: background 0.1s ease;
+  cursor: pointer;
+}
+.students-table-row:hover { background: var(--muted); }
+.student-avatar {
+  display: grid;
+  place-items: center;
+  width: 2.2rem;
+  height: 2.2rem;
+  border-radius: 50%;
+  background: var(--im-red-light);
+  color: var(--im-red);
+  font: 700 0.78rem var(--font-sans);
+  flex-shrink: 0;
+}
+.student-name { font-size: 0.88rem; font-weight: 600; }
+.student-phone { font-size: 0.78rem; color: var(--muted-foreground); margin-top: 0.15rem; }
+.student-origin { font-size: 0.75rem; color: var(--muted-foreground); }
+
+/* Timeline */
+.timeline { display: grid; gap: 0; padding-left: 1.5rem; border-left: 2px solid var(--border); }
+.timeline-item { position: relative; padding: 0 0 1.25rem 1.25rem; }
+.timeline-item::before {
+  content: "";
+  position: absolute;
+  left: -0.45rem;
+  top: 0.35rem;
+  width: 0.6rem;
+  height: 0.6rem;
+  border-radius: 50%;
+  background: var(--im-red);
+  border: 2px solid var(--card);
+  box-shadow: 0 0 0 2px var(--im-red);
+}
+.timeline-item .tl-time { font-size: 0.7rem; color: var(--muted-foreground); margin-bottom: 0.25rem; }
+.timeline-item .tl-text { font-size: 0.84rem; }
+
+/* ===========================================================
+   FOLLOW-UP CARDS
+   =========================================================== */
+.followup-card {
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: start;
+  gap: 0.85rem;
+  padding: 1.1rem;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--card);
+  transition: box-shadow 0.15s ease;
+}
+.followup-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); }
+.followup-card.overdue { border-color: #dc2626; background: #fff5f5; }
+.followup-card.completed { opacity: 0.6; }
+.followup-time-block {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.15rem;
+  min-width: 3.5rem;
+  text-align: center;
+}
+.followup-time-block .fu-date { font: 700 1.4rem / 1 var(--font-display); color: var(--im-red-dark); }
+.followup-time-block .fu-month { font-size: 0.65rem; font-weight: 600; text-transform: uppercase; color: var(--muted-foreground); }
+.followup-time-block .fu-time { font-size: 0.72rem; font-weight: 600; color: var(--im-red); margin-top: 0.2rem; }
+.followup-body .fu-student { font-size: 0.88rem; font-weight: 700; }
+.followup-body .fu-obs { margin-top: 0.3rem; font-size: 0.78rem; color: var(--muted-foreground); line-height: 1.55; }
+.followup-body .fu-course { margin-top: 0.5rem; font-size: 0.72rem; color: var(--im-red); font-weight: 600; }
+.fu-status-badge {
+  padding: 0.25rem 0.6rem;
+  border-radius: 2rem;
+  font-size: 0.65rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  flex-shrink: 0;
+}
+.fu-pending { background: #fef3c7; color: #92400e; }
+.fu-overdue { background: #dc2626; color: white; }
+.fu-completed { background: #f0fdf4; color: #16a34a; }
+
+/* ===========================================================
+   PROPOSAL SNAPSHOT CARD
+   =========================================================== */
+.proposal-card {
+  border: 1px solid var(--border);
+  border-radius: var(--radius-xl);
+  overflow: hidden;
+  background: var(--card);
+}
+.proposal-header {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: start;
+  gap: 1rem;
+  padding: 1.1rem 1.3rem;
+  background: var(--muted);
+  border-bottom: 1px solid var(--border);
+}
+.proposal-course-name { font-size: 0.9rem; font-weight: 700; color: var(--im-red-dark); }
+.proposal-meta { font-size: 0.72rem; color: var(--muted-foreground); margin-top: 0.15rem; }
+.proposal-body { padding: 1.1rem 1.3rem; }
+.proposal-prices {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.75rem;
+}
+.proposal-table-price { font-size: 0.8rem; color: var(--muted-foreground); }
+.proposal-final-price {
+  font: 700 1.4rem var(--font-display);
+  color: var(--im-red-dark);
+  letter-spacing: -0.02em;
+}
+.proposal-installments { font-size: 0.78rem; color: var(--muted-foreground); }
+.proposal-installments strong { color: var(--im-red); }
+.proposal-savings {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  margin-top: 0.6rem;
+  padding: 0.3rem 0.65rem;
+  background: #fef3c7;
+  border-radius: 2rem;
+  font-size: 0.72rem;
+  font-weight: 700;
+  color: #92400e;
+}
+
+/* Status badges */
+.status-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.3rem;
+  padding: 0.25rem 0.65rem;
+  border-radius: 2rem;
+  font-size: 0.68rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+.status-draft { background: #f3f4f6; color: #6b7280; }
+.status-sent { background: #eff6ff; color: #1d4ed8; }
+.status-waiting { background: #fef3c7; color: #92400e; }
+.status-negotiation { background: #fef2f2; color: var(--im-red); }
+.status-approved { background: #f0fdf4; color: #15803d; }
+.status-rejected { background: #fef2f2; color: #991b1b; }
+.status-expired { background: #f3f4f6; color: #6b7280; }
+
+/* ===========================================================
+   ADMIN TABLES
+   =========================================================== */
+.admin-table-wrap {
+  border: 1px solid var(--border);
+  border-radius: var(--radius-xl);
+  overflow: hidden;
+  background: var(--card);
+}
+.admin-table-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 1rem 1.25rem;
+  border-bottom: 1px solid var(--border);
+  background: var(--muted);
+}
+.admin-table-header h2 { font-size: 0.92rem; font-weight: 700; }
+.admin-table { width: 100%; border-collapse: collapse; }
+.admin-table th {
+  padding: 0.7rem 1rem;
+  text-align: left;
+  font-size: 0.72rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  color: var(--muted-foreground);
+  background: var(--muted);
+  border-bottom: 1px solid var(--border);
+}
+.admin-table td {
+  padding: 0.8rem 1rem;
+  font-size: 0.84rem;
+  border-bottom: 1px solid var(--border);
+  vertical-align: middle;
+}
+.admin-table tbody tr:last-child td { border-bottom: none; }
+.admin-table tbody tr:hover td { background: var(--muted); }
+
+/* ===========================================================
+   BRANDING / IDENTIDADE VISUAL ADMIN
+   =========================================================== */
+.branding-preview {
+  border: 1px solid var(--border);
+  border-radius: var(--radius-xl);
+  overflow: hidden;
+}
+.branding-preview-bar {
+  padding: 1rem 1.5rem;
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  font: 700 0.88rem var(--font-sans);
+  color: white;
+}
+.color-swatch {
+  display: flex;
+  gap: 0.5rem;
+  align-items: center;
+}
+.swatch {
+  width: 2.2rem;
+  height: 2.2rem;
+  border-radius: 0.4rem;
+  border: 2px solid rgba(0,0,0,0.1);
+  cursor: pointer;
+  transition: transform 0.1s ease;
+}
+.swatch:hover { transform: scale(1.1); }
+
+/* ===========================================================
+   EMPTY STATES
+   =========================================================== */
+.empty-state {
+  display: grid;
+  min-height: 18rem;
+  place-items: center;
+  align-content: center;
+  gap: 0.75rem;
+  padding: 3rem 2rem;
+  border: 1.5px dashed var(--border);
+  border-radius: var(--radius-xl);
+  text-align: center;
+}
+.empty-state .empty-icon-wrap {
+  display: grid;
+  place-items: center;
+  width: 3.5rem;
+  height: 3.5rem;
+  border-radius: 50%;
+  background: var(--im-red-light);
+  color: var(--im-red);
+  margin: 0 auto;
+}
+.empty-state h2 { font: 600 1.2rem var(--font-display); color: var(--im-red-dark); }
+.empty-state p { color: var(--muted-foreground); font-size: 0.85rem; max-width: 24rem; }
+
+/* ===========================================================
+   SEARCH
+   =========================================================== */
+.search-wrap {
+  position: relative;
+}
+.search-wrap svg {
+  position: absolute;
+  left: 0.85rem;
+  top: 50%;
+  transform: translateY(-50%);
+  color: var(--muted-foreground);
+  width: 0.95rem;
+}
+.search-wrap input { padding-left: 2.3rem; }
+
+/* ===========================================================
+   AUDIT LOG
+   =========================================================== */
+.audit-row {
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: start;
+  gap: 0.85rem;
+  padding: 0.85rem 0;
+  border-bottom: 1px solid var(--border);
+}
+.audit-row:last-child { border-bottom: none; }
+.audit-action-badge {
+  padding: 0.2rem 0.55rem;
+  border-radius: var(--radius-sm);
+  font-size: 0.65rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  flex-shrink: 0;
+  background: var(--im-red-light);
+  color: var(--im-red);
+}
+.audit-desc { font-size: 0.82rem; }
+.audit-desc strong { font-weight: 600; }
+.audit-time { font-size: 0.7rem; color: var(--muted-foreground); flex-shrink: 0; }
+
+/* ===========================================================
+   LOADING & SKELETONS
+   =========================================================== */
+.skeleton {
+  background: linear-gradient(90deg, var(--muted) 25%, var(--border) 50%, var(--muted) 75%);
+  background-size: 200% 100%;
+  animation: shimmer 1.4s infinite;
+  border-radius: var(--radius-md);
+}
+@keyframes shimmer {
+  0% { background-position: 200% 0; }
+  100% { background-position: -200% 0; }
+}
+
+/* ===========================================================
+   RESET PASSWORD PAGE
+   =========================================================== */
+.reset-page, .error-page {
+  min-height: 100vh;
+  display: grid;
+  place-items: center;
+  padding: 1.5rem;
+  background: var(--im-red-light);
+}
+.reset-card, .error-page > div {
+  display: grid;
+  width: min(100%, 28rem);
+  gap: 1.2rem;
+  padding: 2rem;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-xl);
+  background: var(--card);
+  box-shadow: 0 16px 50px rgba(0,0,0,0.08);
+}
+.reset-card h1, .error-page h1 {
+  font: 700 1.8rem var(--font-display);
+  color: var(--im-red-dark);
+  letter-spacing: -0.02em;
+}
+.reset-card > p, .error-page p { color: var(--muted-foreground); line-height: 1.6; }
+
+/* ===========================================================
+   RESPONSIVE ÔÇö TABLET & MOBILE
+   =========================================================== */
+@media (max-width: 1024px) {
+  .offer-layout { grid-template-columns: 1fr; }
+  .offer-result-panel { position: static; }
+  .course-grid { grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); }
+}
+
